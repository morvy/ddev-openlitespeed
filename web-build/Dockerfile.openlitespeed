#ddev-generated
# Install OpenLiteSpeed into the DDEV web container and run PHP through the
# LiteSpeed SAPI of DDEV's own PHP build (sury's php<ver>-litespeed), not
# LiteSpeed's separate lsphp packages. Same PHP build as DDEV's php-fpm, so the
# extension set, php.ini and conf.d are shared with it (see docs/php-parity.md):
# - every extension DDEV ships, for every PHP version DDEV supports (5.6-8.5, 8.6 on newer DDEV)
# - DDEV's start-time php.ini edits (timezone) and .ddev/php/*.ini overrides
# - `ddev xdebug` / `ddev xhprof` (phpenmod/phpdismod act on the shared conf.d)

RUN <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

V="${DDEV_PHP_VERSION}"
SERVER_ROOT=/usr/local/lsws

# LiteSpeed apt repo, for OpenLiteSpeed itself.
wget -qO- https://repo.litespeed.sh | bash >/dev/null 2>&1
apt-get update
# apt may also move the image's php${V}-* packages to the repo's current version
# (all together, so cli/fpm/litespeed stay consistent).
DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
  openlitespeed "php${V}-litespeed"

# Share DDEV's fpm php.ini and conf.d. DDEV's start.sh rewrites php.ini in place
# (`perl -pi`), which turns the php.ini link into a regular file holding the same
# edits; the conf.d link stays, and is where start.sh copies .ddev/php/*.ini.
rm -rf "/etc/php/${V}/litespeed/conf.d" "/etc/php/${V}/litespeed/php.ini"
ln -s ../fpm/conf.d  "/etc/php/${V}/litespeed/conf.d"
ln -s ../fpm/php.ini "/etc/php/${V}/litespeed/php.ini"

# OLS's stable lsphp path -> our SAPI (overwrites the bundled lsphp 5.6).
mkdir -p "${SERVER_ROOT}/fcgi-bin"
ln -sf "/usr/bin/lsphp${V}" "${SERVER_ROOT}/fcgi-bin/lsphp"

mkdir -p "${SERVER_ROOT}/conf/vhosts/ddev" "${SERVER_ROOT}/logs" "${SERVER_ROOT}/tmp" "${SERVER_ROOT}/cachedata"
EOF

# DDEV-managed OLS configuration.
COPY --chmod=0644 ./openlitespeed/httpd_config.conf /usr/local/lsws/conf/httpd_config.conf
# vhost is a template (docroot injected at container start); rendered by the start script.
COPY --chmod=0644 ./openlitespeed/vhost.conf /usr/local/lsws/conf/vhosts/ddev/vhconf.conf.tmpl
COPY --chmod=0755 ./openlitespeed/ddev-openlitespeed-start /usr/local/bin/ddev-openlitespeed-start
COPY --chmod=0755 ./openlitespeed/ddev-openlitespeed-lsphp /usr/local/bin/ddev-openlitespeed-lsphp

# The web container runs as an arbitrary non-root, per-project user. Make OLS's
# runtime dirs writable by any user so it can start, render config, and write
# logs/cache/sockets. (Done after COPY so it also covers the config files.)
RUN chmod -R ugo+rwX \
      /usr/local/lsws/conf \
      /usr/local/lsws/logs \
      /usr/local/lsws/tmp \
      /usr/local/lsws/cachedata
