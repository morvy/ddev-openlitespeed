#!/bin/bash
#ddev-generated
# lsphp daemon (LiteSpeed SAPI of DDEV's PHP) for OLS to connect to on 127.0.0.1:9000.
#
# DDEV runs web_extra_daemons as `bash -c '<cmd>; exit_code=$?; ...'`, so a
# `supervisorctl restart` (which `ddev xdebug`/`ddev xhprof` do for generic web
# servers) signals that bash, not us. An lsphp started with `exec` would be left
# running, keep the port and serve the old ini while the new one fails to bind.
# So: clear any previous lsphp first, and forward TERM/INT to our own lsphp.

pkill -TERM -x lsphp 2>/dev/null
for _ in $(seq 1 50); do
  pgrep -x lsphp >/dev/null || break
  sleep 0.1
done
pkill -KILL -x lsphp 2>/dev/null

PHP_LSAPI_CHILDREN="${OLS_LSAPI_CHILDREN:-10}" /usr/local/lsws/fcgi-bin/lsphp -b 127.0.0.1:9000 &
LSPHP_PID=$!
trap 'kill -TERM "${LSPHP_PID}" 2>/dev/null; wait "${LSPHP_PID}"; exit 0' TERM INT
wait "${LSPHP_PID}"
