#!/bin/bash
#ddev-generated
# Foreground wrapper for OpenLiteSpeed under DDEV `web_extra_daemons`.
#
# OLS daemonizes itself, but supervisord expects a foreground process. So we:
#   1. render the vhost config with the project's real docroot
#   2. pin OLS's server user/group to the container's runtime (code-owning) user
#   3. start OLS (which detaches) and stream its logs so `ddev logs -f` shows them
#   4. block until OLS exits, then return so supervisord restarts us
set -u

SERVER_ROOT=/usr/local/lsws
RUN_USER="$(id -un)"
RUN_GROUP="$(id -gn)"

# Resolve the docroot: DDEV mounts the project at /var/www/html; DDEV_DOCROOT is
# the (possibly empty) subdirectory configured with `ddev config --docroot`.
DOCROOT="/var/www/html"
[ -n "${DDEV_DOCROOT:-}" ] && DOCROOT="/var/www/html/${DDEV_DOCROOT}"

# Render vhconf.conf from the template every start (docroot changes need no rebuild).
sed "s|##DDEV_DOCROOT##|${DOCROOT}|g" \
  "${SERVER_ROOT}/conf/vhosts/ddev/vhconf.conf.tmpl" \
  > "${SERVER_ROOT}/conf/vhosts/ddev/vhconf.conf"

# Pin OLS to the current (code-owning) user.
sed -i \
  -e "s|^user .*|user                      ${RUN_USER}|" \
  -e "s|^group .*|group                     ${RUN_GROUP}|" \
  "${SERVER_ROOT}/conf/httpd_config.conf"

mkdir -p /tmp/lshttpd "${SERVER_ROOT}/logs"
: > "${SERVER_ROOT}/logs/error.log"  2>/dev/null || true
: > "${SERVER_ROOT}/logs/access.log" 2>/dev/null || true

OLS_PID=""
TAIL_PID=""

# On TERM/INT stop only the OLS this wrapper started (a newer wrapper may already
# be running its own), then the log tail.
graceful_stop() {
  if [ -n "${OLS_PID}" ]; then
    kill -TERM "${OLS_PID}" 2>/dev/null
    for _ in $(seq 1 50); do
      kill -0 "${OLS_PID}" 2>/dev/null || break
      sleep 0.1
    done
    kill -KILL "${OLS_PID}" 2>/dev/null
  fi
  [ -n "${TAIL_PID}" ] && kill "${TAIL_PID}" 2>/dev/null
  exit 0
}
trap graceful_stop TERM INT

# Wait up to $1 tenths of a second for every OLS process to exit.
wait_ols_gone() {
  for _ in $(seq 1 "$1"); do
    pgrep -x litespeed >/dev/null || return 0
    sleep 0.1
  done
  return 1
}

# DDEV runs daemons as `bash -c '<cmd>; ...'` with stopasgroup, so `supervisorctl
# restart` (which `ddev xdebug`/`ddev xhprof` do) TERMs the old wrapper too, and its
# trap would still be stopping OLS while this instance starts one. KILL old wrappers
# (anchored: a `ddev exec less <this file>` must not match) and their log tails,
# then stop every OLS and wait until it is gone, so :80 is free.
# Not `lswsctrl stop`: it sends USR2 (graceful restart) before TERM, and its
# `{1..15}` wait loop runs once under dash, so it returns with OLS still running.
for pid in $(pgrep -f '^(/usr)?/bin/bash /usr/local/bin/ddev-openlitespeed-start$'); do
  [ "${pid}" = "$$" ] || kill -KILL "${pid}" 2>/dev/null
done
pkill -f "^tail -n0 -F ${SERVER_ROOT}/logs/" 2>/dev/null
pkill -TERM -x litespeed 2>/dev/null
if ! wait_ols_gone 50; then
  pkill -KILL -x litespeed 2>/dev/null
  wait_ols_gone 20
fi
rm -f /tmp/lshttpd/lshttpd.pid

"${SERVER_ROOT}/bin/lswsctrl" start
OLS_PID="$(cat /tmp/lshttpd/lshttpd.pid 2>/dev/null)"
if [ -z "${OLS_PID}" ] || ! kill -0 "${OLS_PID}" 2>/dev/null; then
  # Non-zero, so DDEV's daemon wrapper pauses before supervisord retries.
  echo "ddev-openlitespeed: OpenLiteSpeed failed to start" >&2
  exit 1
fi

# Stream logs to this process's stdout so they reach `ddev logs`.
tail -n0 -F "${SERVER_ROOT}/logs/error.log" "${SERVER_ROOT}/logs/access.log" &
TAIL_PID=$!

# Block until OLS stops running, then let supervisord restart the daemon.
while "${SERVER_ROOT}/bin/lswsctrl" status 2>/dev/null | grep -q 'is running'; do
  sleep 2
done

kill "${TAIL_PID}" 2>/dev/null || true
